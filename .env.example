# Eco Quest — single root environment file
# Copy to .env at the repo root: cp .env.example .env
#
# Security: never prefix backend secrets with EXPO_PUBLIC_ or VITE_.
# Those prefixes expose values to client JavaScript bundles.

# --- Backend (server-only) ---
PORT=4000
NODE_ENV=development

FIREBASE_PROJECT_ID=ecoquest-496612
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=ecoquest-496612.firebasestorage.app

# Optional: leave FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY empty to use ADC (gcloud auth application-default login)
AI_PROVIDER=qwen
AI_API_KEY=
AI_MODEL=qwen3-vl-flash
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_LOW_CONFIDENCE_THRESHOLD=0.7
AI_CLASSIFICATION_ENABLED=false

# Optional Google Gemini alternate:
# AI_PROVIDER=google
# AI_MODEL=gemini-2.0-flash
# If gemini-2.0-flash fails, try gemini-2.0-flash-001 or gemini-1.5-flash

# --- API URLs (often differ: admin on localhost, phone on LAN IP) ---
VITE_API_URL=http://localhost:4000/api
EXPO_PUBLIC_API_URL=http://192.168.x.x:4000/api

# --- Firebase client config (public; duplicate values with each prefix) ---
VITE_FIREBASE_API_KEY=your_public_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_APP_ID=your_firebase_app_id

EXPO_PUBLIC_FIREBASE_API_KEY=your_public_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# --- Google Maps (mobile) ---
# GOOGLE_MAPS_* are injected into native projects at prebuild (app.config.js).
# EXPO_PUBLIC_GOOGLE_MAPS_* are used in JavaScript (MapViewDirections fallbacks).
GOOGLE_MAPS_IOS_API_KEY=your_ios_maps_sdk_key
GOOGLE_MAPS_ANDROID_API_KEY=your_android_maps_sdk_key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=your_ios_maps_sdk_key
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your_android_maps_sdk_key
EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=your_directions_api_key

# --- Google Maps (admin web) ---
# Enable Maps JavaScript API, Places API, and Directions API for this key.
VITE_GOOGLE_MAPS_WEB_API_KEY=your_web_maps_api_key
