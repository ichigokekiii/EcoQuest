rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isCreatingOwnUserDoc(userId) {
      return isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "user"
        && request.resource.data.status == "active"
        && request.resource.data.points == 0
        && request.resource.data.level == 1
        && request.resource.data.totalTrashCollected == 0
        && request.resource.data.routesCompleted == 0
        && request.resource.data.achievementsCount == 0;
    }

    function isSafeUserProfileUpdate(userId) {
      return isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.points == resource.data.points
        && request.resource.data.level == resource.data.level
        && request.resource.data.totalTrashCollected == resource.data.totalTrashCollected
        && request.resource.data.routesCompleted == resource.data.routesCompleted
        && request.resource.data.achievementsCount == resource.data.achievementsCount;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isCreatingOwnUserDoc(userId);
      allow update: if isSafeUserProfileUpdate(userId) || isAdmin();
      allow delete: if false;
    }

    match /routes/{routeId} {
      allow read: if resource.data.status == "active" || isAdmin();
      allow write: if false;
    }

    match /missions/{missionId} {
      allow read: if resource.data.status == "active" || isAdmin();
      allow write: if false;
    }

    match /trashCategories/{categoryId} {
      allow read: if resource.data.status == "active" || isAdmin();
      allow write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if resource.data.status == "available" || isAdmin();
      allow write: if false;
    }

    match /routeSessions/{sessionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /trashSubmissions/{submissionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /redemptions/{redemptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /pointTransactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /trashClassificationExamples/{exampleId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
